<%- include('partials/header.ejs'); -%>

<h2>Add book</h2>

<form action="/add" method="post">
    <label for="title">Book title</label>
    <input type="text" name="title" id="title" required>

    <label for="description">Book description</label>
    <textarea name="description" id="description" required></textarea>

    <label for="rating">Book rating</label>
    <input type="number" name="rating" id="rating" required>

    <label for="finished_reading">Ending date</label>
    <input type="date" name="finished_reading" id="finished_reading" required>

    <label for="isbn">ISBN</label>
    <input type="number" name="isbn" id="isbn" required>

    <button type="submit">Submit book</button>
</form>

<%- include('partials/footer.ejs'); -%>