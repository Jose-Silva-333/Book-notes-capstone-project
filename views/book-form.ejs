<%- include('partials/header.ejs'); -%>

<h2><%= book ? 'Edit' : 'Add' %> book</h2>

<form action="<%= book ? `/edit/${book.id}` : '/add' %>" method="post">
    <label for="title">Book title</label>
    <input type="text" name="title" id="title" value="<%= book ? book.title : '' %>" required>

    <label for="description">Book description</label>
    <textarea name="description" id="description" required><%= book ? book.description : '' %></textarea>

    <label for="rating">Book rating</label>
    <input type="number" name="rating" id="rating" value="<%= book ? book.rating : '' %>" required>

    <label for="finished_reading">Ending date</label>
    <input type="date" name="finished_reading" id="finished_reading" value="<%= book ? book.finished_reading : '' %>" required>

    <label for="isbn">ISBN</label>
    <input type="text" name="isbn" id="isbn" value="<%= book ? book.isbn : '' %>" required>

    <button type="submit"><%= book ? 'Update' : 'Submit' %> book</button>
</form>
<a href="/?edit=true"><button>Cancel</button></a>

<%- include('partials/footer.ejs'); -%>