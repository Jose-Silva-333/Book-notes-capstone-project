<%- include('partials/header.ejs'); -%>

<h2>Add book</h2>

<form action="/add" method="post">
    <label for="title">Book title</label>
    <input type="text" name="title" id="title" value="<%= book.title %>" required>

    <label for="description">Book description</label>
    <textarea name="description" id="description" required><%= book.description %></textarea>

    <label for="rating">Book rating</label>
    <input type="number" name="rating" id="rating" value="<%= book.rating %>" required>

    <label for="finished_reading">Ending date</label>
    <input type="date" name="finished_reading" id="finished_reading" value="<%= book.finished_reading %>" required>

    <label for="isbn">ISBN</label>
    <input type="text" name="isbn" id="isbn" value="<%= book.isbn %>" required>

    <button type="submit">Submit book</button>
</form>

<%- include('partials/footer.ejs'); -%>