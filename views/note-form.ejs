<%- include('partials/header.ejs'); -%>

<h2><%= note ? 'Edit note from' : 'Add note to' %> "<%= note ? note.book_title : book.title %>"</h2>

<form action="<%= note ? `/notes/edit/${note.id}` : `/notes/add/${book.id}` %>" method="post" class="form-layout">

    <label for="body_text">Note Text:</label>
    <textarea name="body_text" id="body_text" rows="5" required><%= note ? note.body_text : '' %></textarea>

    <div class="form-buttons">
        <button type="submit" class="btn">
            <%= note ? 'Update' : 'Submit' %> note
        </button>
        <button type="button" class="btn" 
                onclick="window.location.href='/notes/<%= note ? note.book_id : book.id %>?edit=true'">
            Cancel
        </button>
    </div>
</form>

<%- include('partials/footer.ejs'); -%>