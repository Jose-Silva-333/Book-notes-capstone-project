<%- include('partials/header.ejs'); -%>

<h2><%= note ? 'Edit' : 'Add' %> note to <%= note ? note.book_title : book.title %></h2>

<form action="<%= note ? `/notes/edit/${note.id}` : `/notes/add/${book.id}` %>" method="post">

    <label for="body_text">Note Text:</label>
    <textarea name="body_text" id="body_text" required><%= note ? note.body_text : '' %></textarea>

    <button type="submit">Submit Note</button>

</form>

<a href="/notes/<%= note ? note.book_id : book.id %>?edit=true"><button>Cancel</button></a>

<%- include('partials/footer.ejs'); -%>