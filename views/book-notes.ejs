<%- include('partials/header.ejs'); -%>

    <% if (editing === false) { %>
        <a href="/"><button>Back to book list</button></a>
    <a href="/notes/<%= book.id %>?edit=true"><button>Edit Notes list</button></a>
    <% } else { %>
    <a href="/notes/<%= book.id %>"><button>Done</button></a>
    <% } %>
    <hr />

    <h2><%= book.title %></h2>
    <p><%= book.description %></p>
    <p>Rating: <%= book.rating %>/5</p>
        
    <% if (book.coverUrl) { %>
        <img src="<%= book.coverUrl %>" alt="<%= book.title %> cover">
    <% } %>
        
    <h2>Notes</h2>
    <% if (notes && notes.length > 0) { %>
        <% notes.forEach(note => { %>
            <p><%= note.body_text || note.text %></p>
        <% }); %>
    <% } else { %>
        <p>No notes yet.</p>
    <% } %>
    <% if (editing === true) { %>
    <a href="/notes/add/<%= book.id %>"><button>Add Note</button></a>
    <% } %>

<%- include('partials/footer.ejs'); -%>