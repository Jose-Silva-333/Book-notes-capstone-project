<%- include('partials/header.ejs'); -%>

    <% if (editing === false) { %>
        <a href="/"><button class="btn">Back to book list</button></a>
    <a href="/notes/<%= book.id %>?edit=true"><button class="btn">Edit Notes list</button></a>
    <% } else { %>
    <a href="/notes/<%= book.id %>"><button class="btn">Done</button></a>
    <% } %>
    <hr />

    <h2><%= book.title %></h2>
    <p><%= book.description %></p>
    <p>Rating: <%= book.rating %>/5</p>
        
    <% if (book.coverUrl) { %>
        <img src="<%= book.coverUrl %>" alt="<%= book.title %> cover">
    <% } %>
        
    <h2>Notes</h2>
    <% if (notes && notes.length > 0) { %>
        <% notes.forEach(note => { %>
            <p><%= note.body_text %></p>
            <% if (editing === true) { %>
            <a href="/notes/edit/<%= note.id %>"><button class="btn">Edit Note</button></a>
            <button class="btn" onclick="deleteNote(<%= note.id %>)">Delete Note</button>
            <% } %>
        <% }); %>
    <% } else { %>
        <p>No notes yet.</p>
    <% } %>
    <% if (editing === true) { %>
    <div class="add-button">
    <br />
    <a href="/notes/add/<%= book.id %>"><button class="btn">Add Note</button></a>
    </div>
    <% } %>

<%- include('partials/footer.ejs'); -%>

<script>
function deleteNote(noteId) {
  if (confirm('Are you sure you want to delete this note?')) {
    fetch(`/notes/${noteId}`, {
      method: 'DELETE'
    })
    .then(response => {
      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to delete note');
      }
    })
    .catch(err => {
      console.error(err);
      alert('Error deleting note');
    });
  }
}
</script>