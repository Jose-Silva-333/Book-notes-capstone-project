<%- include('partials/header.ejs'); -%>

<h2>Thoughts Inspired by Books I've Read</h2>
<p>
    This website collects some of the analysis and reflections I've written about books I've read over the years.
    I'm not a prolific reader, but I'll keep this page updated as I add new titles to my reading history.
</p>
<p>
    You can sort the entries however you like — by <a href="/?orderBy=title">title</a>, <a href="/?orderBy=finished_reading">most recent</a>, or <a href="/?orderBy=rating">highest rated</a>.
</p>
<% if (editing === false) { %>
<a href="/?edit=true"><button>Edit page</button></a>
<% } else { %>
<a href="/"><button>Done</button></a>
<% } %>
<hr />

<% for(let book of books) { %>

<% if(editing === false) { %>
<a href="/notes/<%= book.id %>">
    <img src="<%= book.coverUrl %>"/>
    <h3>
        <%=book.title%>
    </h3>
</a>
<% } else { %>
<div>
    <img src="<%= book.coverUrl %>"/>
    <h3>
        <%=book.title%>
    </h3>
</div>
<% } %>
<p>Date finished: <%= new Date(book.finished_reading).toLocaleDateString() %></p>
<p>Rating: <%= book.rating %>/5 &#9733</p>
<p><%= book.description %></p>
<% if(editing === false) { %>
<p>Check out my notes on <a href="/notes/<%= book.id %>">this link.</a></p>
<% } else { %>
<p>Check out my notes on this link.</p>
<a href="/edit/<%= book.id %>"><button>Edit Book</button></a>
<button onclick="deleteBook(<%= book.id %>)">Delete Book</button>
<% } %>
<% } %>

<% if(editing === true) { %>
<br /><a href="/add"><button>Add Book</button></a>
<% } %>

<%- include('partials/footer.ejs'); -%>

<script>
function deleteBook(bookId) {
  if (confirm('Are you sure you want to delete this book?')) {
    fetch(`/${bookId}`, {
      method: 'DELETE'
    })
    .then(response => {
      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to delete book');
      }
    })
    .catch(err => {
      console.error(err);
      alert('Error deleting book');
    });
  }
}
</script>